cabal-version:       2.4
name:                Barnes-Hut
version:             0.2.0.0
synopsis:            Barnes-Hut O(n log n) N-body gravitational simulation
description:         An efficient N-body gravitational simulation using the
                     Barnes-Hut quadtree algorithm for O(n log n) force
                     approximation. Features multiple preset scenarios,
                     galaxy density models, and real-time Gloss visualization.
homepage:            https://github.com/adityavkk/N-Body-Simulations
license:             BSD-3-Clause
license-file:        LICENSE
author:              Aditya K
maintainer:          adityavkk@gmail.com
copyright:           2017-2026 Aditya K
category:            Simulation
build-type:          Simple
extra-source-files:  README.md

library
  hs-source-dirs:      src
  default-language:    GHC2021
  ghc-options:         -Wall -O2
  exposed-modules:     DataTypes
                     , Gravity
                     , Bodies
                     , BarnesHut
                     , GalaxyModels
                     , Utils
                     , Integration
                     , Render
  build-depends:       base >= 4.17 && < 5
                     , gloss >= 1.13 && < 1.14
                     , QuickCheck >= 2.14 && < 2.16
                     , random >= 1.2 && < 1.3

executable Barnes-Hut-Exe
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    GHC2021
  ghc-options:         -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:       Barnes-Hut
                     , base >= 4.17 && < 5

test-suite Barnes-Hut-Test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  other-modules:       BarnesHutSpec
                     , GravitySpec
  default-language:    GHC2021
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base >= 4.17 && < 5
                     , QuickCheck >= 2.14 && < 2.16
                     , hspec >= 2.11 && < 2.12
                     , Barnes-Hut

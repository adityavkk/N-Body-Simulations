cabal-version:       2.4
name:                Direct-Simulation
version:             0.2.0.0
synopsis:            Direct O(n²) N-body gravitational simulation
description:         A direct-sum gravitational N-body simulation using
                     Gloss for real-time 2D visualization. Calculates
                     pairwise gravitational forces between all bodies.
homepage:            https://github.com/adityavkk/N-Body-Simulations
license:             BSD-3-Clause
license-file:        LICENSE
author:              Aditya V K
maintainer:          adityavkk@gmail.com
copyright:           2017-2026 Aditya V K
category:            Simulation
build-type:          Simple
extra-source-files:  README.md

executable Direct-Simulation
  hs-source-dirs:      src
  main-is:             Main.hs
  other-modules:       DataTypes
                     , Gravity
                     , SolarSystem
  default-language:    GHC2021
  ghc-options:         -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base >= 4.17 && < 5
                     , gloss >= 1.13 && < 1.14
